DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME"

PORT=5000
NODE_ENV=development

JWT_ACCESS_SECRET=YOUR_ACCESS_SECRET
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=YOUR_REFRESH_SECRET
JWT_REFRESH_EXPIRES_IN=7d

ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=5000

# Medical Report Simplifier - internal Python service (port 8001)
MEDICAL_REPORT_SERVICE_URL=http://127.0.0.1:8001
MEDICAL_REPORT_TIMEOUT_MS=30000
MEDICAL_REPORT_MAX_UPLOAD_MB=15
MEDICAL_REPORT_SERVICE_TOKEN=change-me-internal-token
REPORT_UPLOAD_RATE_LIMIT=20
# chrome | msedge | empty for auto-detect (bundled Chromium first)
MEDICAL_REPORT_PDF_CHANNEL=

HELPER_REFERENCE_CODE=YOUR_HELPER_REFERENCE_CODE

FRONTEND_ORIGIN=http://localhost:5173

# Hospital staff no longer self-register with a global code: each facility has
# its own registration code, created and rotated by an administrator in the app.
# Required secret used to key (HMAC) stored facility registration codes.
FACILITY_CODE_PEPPER=YOUR_FACILITY_CODE_PEPPER

# Verified cross-facility child access grant lifetime, in hours (default 8)
CHILD_ACCESS_GRANT_HOURS=8

# Child verification attempts allowed per account per 15 minutes (default 10)
CHILD_VERIFY_RATE_LIMIT=10

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123

REGISTER_RATE_LIMIT=10

SMS_PROVIDER=mock
REMINDER_TICK_SECONDS=60
REMINDER_SCHEDULER_ENABLED=true